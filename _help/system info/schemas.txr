System_data
	item_name
	item_data (json)

	laravel timestamps
Users
	...Laravel defaults
	user_role_id
	is_active (boolean)

	laravel timestamps
User_roles
	...Laravel defaults
	role_name
	role_permissions (json)

	laravel timestamps
Clients
	id,
	client_name - text
	client_contact - text
	client_gender - text
	payment_plan - text (either 'monthly' or 'per_visit')
	credit_balance (used to store how much they paid last time, stored in kenya shillings)
	kra_pin - text (not necessary can be null)
	id_number - text (i know why its not a number)
	extra_details (json)

	laravel timestamps
tasks
	id,
	task_no (unique string to define jobs)
	client_id,
	client_name,
	status (number)
	payment_status (paid, incomplete, or unpaid)
	is_paid (boolean)
	notes

	laravel timestamps
Samples
	id,
	sample_no (unique string to define samples)
	sample_tag (a name that can be given for easy identification later)
	sample_type
	sample_count
	date_added

	laravel timestamps
results
	id,
	sample_id,
	sample_type,
	client_id,
	added_by,

	au_ppm
	cu_ppm

	laravel timestamps
Payments
	id
	task_id (links to task_id in tasks table)
	status (number)
	amount
	client_id

	laravel timestamps

biz_data
	id
	item_name
	item_data (json) (can hold both json, text and numbers if required)
	added_by
	modified_by

	laravel timestamps
reports
	task_id
	created_by (id of a user)
	sample_id (id of the samples)
	client_id (id of client)
	added_by (links to users.id)
	gen_report_id
	gen_report

	laravel timestamp
reports_gen
	id
	company_contact
	smaple_type
	sample_count
